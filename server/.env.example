# --- Database ---------------------------------------------------------------
# Connection string for your local Postgres. Adjust user / password / db name.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dayflow

# (Alternatively, omit DATABASE_URL and set the standard PG* vars instead:)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=dayflow

# --- Vault encryption -------------------------------------------------------
# 32-byte key as 64 hex chars. Generate one with:  npm run keygen
# Without this, vault read/write endpoints are disabled. Keep it secret; if you
# change it, previously stored vault passwords can no longer be decrypted.
VAULT_KEY=

# --- Server -----------------------------------------------------------------
PORT=3001
# Comma-separated list of allowed CORS origins (where the frontend is served).
CORS_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:8000

# --- Household access key (the public-deployment gate) ----------------------
# One shared secret that protects the WHOLE API. The app prompts for it once per
# device and stays signed in for SESSION_DAYS. REQUIRED for any public deploy.
# Pick a long random value, e.g.:  node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
# If left empty the gate is disabled (open API) — only acceptable on a trusted LAN.
APP_ACCESS_KEY=
SESSION_DAYS=30
# Optional: dedicated HMAC secret for signing session tokens (defaults to VAULT_KEY).
# AUTH_SECRET=

# --- Reminders: Web Push (VAPID) -------------------------------------------
# Generate a keypair with:  npm run vapid   (then paste both values here)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Reminders: Email -------------------------------------------------------
# Leave SMTP_* unset to use built-in Ethereal test mode (logs a preview URL,
# does NOT deliver). For real delivery, fill these in (e.g. Gmail App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
MAIL_FROM=Dayflow <no-reply@dayflow.local>

# How often the in-process scheduler checks for due reminders (milliseconds).
# Used for local/always-on hosting. On serverless (Vercel) the scheduler doesn't
# run; an external cron hits POST /api/cron/run instead — see CRON_SECRET below.
REMINDER_POLL_MS=30000

# --- Serverless reminders (Vercel) ------------------------------------------
# Secret that protects POST /api/cron/run. Set this AND configure a free cron
# (e.g. cron-job.org) to call the endpoint every minute. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
# Leave empty if you run an always-on server (the built-in scheduler handles it).
CRON_SECRET=

# --- Face unlock + login codes (OTP) ---------------------------------------
# Face descriptors are encrypted at rest with VAULT_KEY (required for face).
# FACE_MATCH_THRESHOLD: lower = stricter face match (face-api convention ~0.5-0.6).
# OTP_TTL_MIN: minutes a login code stays valid. Codes are emailed via the same
# SMTP/Ethereal setup above and HMAC-hashed at rest (never stored in plaintext).
# FACE_MATCH_THRESHOLD=0.5
# OTP_TTL_MIN=5
